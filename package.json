{
  "name": "man-shi-mai",
  "version": "1.0.0",
  "private": true,
  "description": "面试麦 — Next.js 与 NestJS Monorepo",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' run dev",
    "dev:web": "pnpm --filter @man-shi-mai/web dev",
    "dev:server": "pnpm --filter @man-shi-mai/server dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @man-shi-mai/web build",
    "build:server": "pnpm --filter @man-shi-mai/server build",
    "start:web": "pnpm --filter @man-shi-mai/web start",
    "start:server": "pnpm --filter @man-shi-mai/server start:prod",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "test:e2e:web": "pnpm --filter @man-shi-mai/web test:e2e",
    "test:e2e:server": "pnpm --filter @man-shi-mai/server test:e2e",
    "check": "pnpm lint && pnpm test && pnpm build",
    "db:seed": "pnpm --filter @man-shi-mai/server db:seed",
    "skills:update": "node apps/web/ai/skills/update-skills.js && node apps/server/ai/skills/update-skills.js",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "pnpm": {
    "overrides": {
      "p-retry": "4.6.2"
    },
    "onlyBuiltDependencies": [
      "@ffmpeg-installer/darwin-arm64",
      "@ffmpeg-installer/linux-x64",
      "@nestjs/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
