# Database Configuration
MONGODB_URI=mongodb://localhost:27017/manshimai
DB_TYPE=mongodb

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=development
# Optional browser origins for direct API calls. Next.js same-origin proxy does not need CORS.
# In production the default is empty; set comma-separated origins only when required.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# AI Configuration (DeepSeek)
# Please fill in your DeepSeek API Key to run AI simulations
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.7
MAX_TOKENS=4000

# Optional: Baidu short speech recognition via HTTPS REST; browser handles TTS.
# Missing either value disables transcription with HTTP 503.
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# Optional: Alibaba Cloud OSS Configuration
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
# RAM role allowed to read/write the app's OSS user directories; STS permissions are further narrowed per user.
OSS_STS_ROLE_ARN=

# Optional: Alipay Configuration
# Payments are unavailable by default. Virtual simulation is allowed only in development/test.
PAYMENT_MODE=disabled
ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
